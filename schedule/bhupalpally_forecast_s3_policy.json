{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::ai-forecasting-storage-429694361053",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/vedanjay/BHUPALPALLY/*",
            "generated/BHUPALPALLY/*",
            "state/vedanjay/BHUPALPALLY/*"
          ]
        }
      }
    },
    {
      "Sid": "ObjectReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::ai-forecasting-storage-429694361053/raw/vedanjay/BHUPALPALLY/*",
        "arn:aws:s3:::ai-forecasting-storage-429694361053/generated/BHUPALPALLY/*",
        "arn:aws:s3:::ai-forecasting-storage-429694361053/state/vedanjay/BHUPALPALLY/*"
      ]
    }
  ]
}
