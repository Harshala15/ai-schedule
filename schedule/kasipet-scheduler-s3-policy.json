{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::ai-forecasting-storage-429694361053",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/vedanjay/KASIPET/*",
            "generated/KASIPET/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::ai-forecasting-storage-429694361053/raw/vedanjay/KASIPET/*"
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::ai-forecasting-storage-429694361053/generated/KASIPET/*"
    }
  ]
}
